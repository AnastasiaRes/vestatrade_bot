LLM_PROVIDER=ollama
# On a computer where Ollama is installed locally, keep this localhost URL.
OLLAMA_BASE_URL=http://localhost:11434
# Проверенная локальная пара для V2: Qwen разбирает реплики, BGE-M3 ищет по
# уже привязанным паспортам. Имена должны совпадать с `ollama list`.
OLLAMA_MODEL=qwen3-vl:8b-instruct
OLLAMA_MODEL_STRONG=qwen3-vl:8b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3
LLM_TIMEOUT_SECONDS=60
# Общий предел на все LLM-агенты одной пользовательской реплики.
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=1

# Диагностика этапов 0–1. Интерпретатор работает только в shadow-mode: его
# результат записывается в JSONL и не влияет на ответ, поиск или состояние.
DIAGNOSTIC_TELEMETRY_ENABLED=false
DIAGNOSTIC_TRACE_PATH=app/data/diagnostics/turns.jsonl
SEMANTIC_SHADOW_ENABLED=false
# SEMANTIC_SHADOW_MODEL=qwen/qwen3-vl-8b-instruct
# Этап 2: типизированное состояние и решение SellerPolicy записываются только
# в shadow-телеметрию и не меняют ответ, карточки или legacy-состояние.
DIALOGUE_STATE_V2_SHADOW_ENABLED=false
SELLER_POLICY_V2_SHADOW_ENABLED=false
PRODUCT_CONTRACTS_V2_SHADOW_ENABLED=false
CATALOG_PLANNER_V2_SHADOW_ENABLED=false
SOLUTION_PLAN_V2_SHADOW_ENABLED=false
# Этап 4: commerce/order/handoff остаются наблюдаемым shadow-контуром.
# Даже при включённых shadow-флагах внешние операции не выполняются.
COMMERCE_WORKFLOWS_V2_SHADOW_ENABLED=false
HANDOFF_WORKFLOW_V2_SHADOW_ENABLED=false
COMMERCE_OUTBOX_V2_SHADOW_ENABLED=false
COMMERCE_EXTERNAL_EXECUTION_ENABLED=false
# Этап 5: план ответа, naturalizer, grounding и защита от циклов работают
# только в shadow-mode. Пользовательский ответ остаётся legacy до этапа 6.
ANSWER_PLAN_V2_SHADOW_ENABLED=false
RESPONSE_RENDERER_V2_SHADOW_ENABLED=false
RESPONSE_GROUNDING_V2_SHADOW_ENABLED=false
PROGRESS_GUARD_V2_SHADOW_ENABLED=false
# Этап 6A: новый контур сначала только сравнивается с legacy. Живая выдача
# требует одновременно валидного migration registry, явного canary-флага и
# доли 1–5%. При ошибочной доле или kill switch трафик остаётся на legacy.
DIALOGUE_V2_ROUTING_ENABLED=false
DIALOGUE_V2_SHADOW_COMPARE_ENABLED=false
DIALOGUE_V2_LIVE_DELIVERY_ENABLED=false
DIALOGUE_V2_INTERNAL_CANARY_ENABLED=false
DIALOGUE_V2_LOCAL_PREVIEW_ENABLED=false
DIALOGUE_V2_INTERNAL_CANARY_PERCENT=0
# Explicit V2-first mode for ordinary /chat traffic. It is not a percentage:
# every accepted V2 candidate is delivered, while rejected candidates fall
# back to Legacy. Keep false until an operator deliberately promotes V2.
DIALOGUE_V2_PUBLIC_PRIMARY_ENABLED=false
# DIALOGUE_V2_MIGRATION_REGISTRY_PATH=app/data/cutover_v2/registry.json
DIALOGUE_V2_LEGACY_DRY_RUN_COMPARE_ENABLED=false
DIALOGUE_V2_FORCE_LEGACY=false
# Per-request modes for the protected integration QA stand. Keep disabled in
# public deployments; both the switch and a matching request token are needed.
DIALOGUE_V2_QA_CONTROLS_ENABLED=false
# DIALOGUE_V2_QA_CONTROL_TOKEN=replace-with-a-long-random-token
# Для локального V2 Preview не меняйте эти значения вручную: используйте
# ./scripts/start_v2_preview.sh. Он включает QA-режим только для loopback,
# сохраняет публичный /chat Legacy и фиксирует canary=0 для своего процесса.

# Stage 7 outcome-evaluation runs only over saved transcripts and never changes
# a customer response. Both flags, verified source-run model provenance and an
# explicit judge from a different foundation family are required for paid calls.
RUN_LIVE_LLM_TESTS=0
RUN_OUTCOME_JUDGE_EVALS=0
# OUTCOME_JUDGE_MODEL=anthropic/claude-sonnet-4

# OpenRouter optional. If LLM_PROVIDER=openrouter but the key is absent or
# empty, runtime automatically uses Ollama and OLLAMA_MODEL[_STRONG].
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct
# OPENROUTER_MODEL_STRONG=qwen/qwen3-vl-8b-instruct
DAILY_BUDGET_USD=10
# Если указан FEED_FILE_PATH, локальный XML используется вместо FEED_URL.
#
# По умолчанию стоит витринный фид на 100 позиций: из него же собран каталог
# демо-страницы (app/static/widget-demo-catalog.json) и на нём работают тесты
# v2. Так ассистент подбирает ровно то, что покупатель видит на витрине.
# С полным фидом демо расходится: витрина показывает 100 товаров, а подбор
# идёт по 14 тысячам, и бот рекомендует позиции, которых на витрине нет.
FEED_FILE_PATH=data/feed_showcase_100_2026-06-14.xml
# Полный ассортимент — для QA-прогонов по живому каталогу:
# FEED_FILE_PATH=data/products_all.xml
FEED_URL=https://www.vestatrade.ru/index.php?route=extension/feed/unixml/all_products
PRODUCTS_CACHE_PATH=app/data/products_cache.json
USAGE_BUDGET_PATH=app/data/usage_budget.json

# Для локальной разработки можно оставить "*".
# В продакшене лучше указать только домены сайта:
# ALLOWED_ORIGINS=https://vestatrade.ru,https://www.vestatrade.ru
ALLOWED_ORIGINS=*

# /reload-feed выключен, пока токен не задан. После включения требуется заголовок:
# X-Admin-Token: <значение RELOAD_FEED_TOKEN>
# RELOAD_FEED_TOKEN=change-me

# Для production с несколькими workers/containers включите общее состояние.
# Credentials не должны попадать в логи или test artifacts.
# SESSION_STORE_URL=redis://:password@redis:6379/0
SESSION_TTL_SECONDS=86400
SESSION_LOCK_TIMEOUT_SECONDS=30
