LLM_PROVIDER=ollama
# Use localhost only when Ollama is installed and running on this machine.
OLLAMA_BASE_URL=http://100.83.233.66:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MODEL_STRONG=qwen2.5-coder:7b
LLM_TIMEOUT_SECONDS=60
# Общий предел на все LLM-агенты одной пользовательской реплики.
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=1

# Диагностика этапов 0–1. Интерпретатор работает только в shadow-mode: его
# результат записывается в JSONL и не влияет на ответ, поиск или состояние.
DIAGNOSTIC_TELEMETRY_ENABLED=false
DIAGNOSTIC_TRACE_PATH=app/data/diagnostics/turns.jsonl
SEMANTIC_SHADOW_ENABLED=false
# SEMANTIC_SHADOW_MODEL=qwen/qwen3-vl-8b-instruct

# Старый OpenRouter-режим оставлен для отката:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct
# OPENROUTER_MODEL_STRONG=qwen/qwen3-vl-8b-instruct
DAILY_BUDGET_USD=10
# Если указан FEED_FILE_PATH, локальный XML используется вместо FEED_URL.
FEED_FILE_PATH=data/products_all.xml
FEED_URL=https://www.vestatrade.ru/index.php?route=extension/feed/unixml/all_products
PRODUCTS_CACHE_PATH=app/data/products_cache.json
USAGE_BUDGET_PATH=app/data/usage_budget.json

# Для локальной разработки можно оставить "*".
# В продакшене лучше указать только домены сайта:
# ALLOWED_ORIGINS=https://vestatrade.ru,https://www.vestatrade.ru
ALLOWED_ORIGINS=*

# /reload-feed выключен, пока токен не задан. После включения требуется заголовок:
# X-Admin-Token: <значение RELOAD_FEED_TOKEN>
# RELOAD_FEED_TOKEN=change-me

# Для production с несколькими workers/containers включите общее состояние.
# Credentials не должны попадать в логи или test artifacts.
# SESSION_STORE_URL=redis://:password@redis:6379/0
SESSION_TTL_SECONDS=86400
SESSION_LOCK_TIMEOUT_SECONDS=30
